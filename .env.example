# ────────────── Carloha Marketing Hub ──────────────
# Copy this file to .env.local and fill in your values.
# See DEPLOYMENT_GUIDE_ZH.md and README.md for setup details.

# Required: Google Sheets CSV URLs for vehicle and general marketing materials.
# Publish your Google Sheet tabs as CSV and paste the URLs here.
NEXT_PUBLIC_VEHICLE_MATERIALS_CSV=
NEXT_PUBLIC_GENERAL_MATERIALS_CSV=

# Required: Google Apps Script web app URL that receives request form submissions.
# Deploy docs/google-apps-script-request-form.js as a web app to get this URL.
REQUEST_FORM_SUBMIT_URL=

# Optional: External analytics endpoint URL to forward collected analytics events.
ANALYTICS_SUBMIT_URL=

# Required: Google Gemini API key for the AI marketing assistant in the sidebar.
GEMINI_API_KEY=

# Optional: Gemini model to use (defaults to gemini-2.5-flash-lite).
ASSISTANT_MODEL=

# Required: Access key for the private /insights analytics dashboard.
# Visit /insights?key=<this-value> to gain access (cookie is set after verification).
INSIGHTS_ACCESS_KEY=
